# Backend config. Copy to .env for local dev. Validated at startup (src/config/env.ts).
NODE_ENV=development
PORT=3000
# Comma-separated origins allowed by CORS (mobile apps don't need CORS; this is for tools/web).
CORS_ORIGINS=http://localhost:8081
# Set to the number of proxy hops in production (e.g. 1 behind a load balancer).
TRUST_PROXY=0

DATABASE_URL=postgresql://safekid:safekid_dev_password@localhost:5433/safekid
# Used by e2e tests; the database is created by docker/postgres/init.
TEST_DATABASE_URL=postgresql://safekid:safekid_dev_password@localhost:5433/safekid_test
REDIS_URL=redis://localhost:6380

# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Pepper for HMAC hashing of OTPs, pairing codes, claim secrets and refresh tokens.
HASH_PEPPER=change-me-to-another-long-random-string-32-chars
JWT_ACCESS_TTL_SECONDS=900
USER_REFRESH_TTL_DAYS=30
DEVICE_REFRESH_TTL_DAYS=180

# console | eskiz
SMS_PROVIDER=console
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_SENDER=4546

# console | fcm
PUSH_PROVIDER=console
# Path to the Firebase service account JSON (never commit it).
FCM_SERVICE_ACCOUNT_PATH=
